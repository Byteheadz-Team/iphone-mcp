{
  "name": "iphone-mcp",
  "version": "0.1.0",
  "description": "MCP server for controlling a physical iPhone connected via USB",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24"
  },
  "bin": "./dist/index.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --cache --fix . && tsc --noEmit",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/node": "^24.10.9",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
