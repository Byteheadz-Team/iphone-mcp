{
  "name": "iphone-mcp",
  "version": "0.1.0",
  "description": "MCP server that controls a physical iPhone from macOS via iPhone Mirroring. Screenshot, tap, swipe, type — no Xcode or WebDriverAgent required.",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "license": "MIT",
  "author": "yev",
  "homepage": "https://github.com/yev/iphone-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yev/iphone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yev/iphone-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "iphone",
    "ios",
    "iphone-mirroring",
    "automation",
    "ai-agent",
    "claude",
    "screenshot",
    "ui-automation",
    "macos"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --cache --fix . && tsc --noEmit",
    "doctor": "tsx src/doctor.ts",
    "prepare": "husky",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/node": "^24.10.9",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
